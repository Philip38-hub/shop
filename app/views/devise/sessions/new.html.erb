<section class="section auth-section">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-4">
        <div class="box auth-box">
          <h2 class="title is-2 has-text-centered">Log in</h2>
          
          <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="field">
              <div class="control">
                <%= f.input :email, required: false, input_html: { class: "input" }, wrapper: false, label_html: { class: "label" } %>
              </div>
            </div>

            <div class="field">
              <div class="control">
                <%= f.input :password, required: false, input_html: { class: "input" }, wrapper: false, label_html: { class: "label" } %>
              </div>
            </div>

            <div class="field">
              <div class="control">
                <%= f.input :remember_me, wrapper: false, as: :boolean if devise_mapping.rememberable? %>
              </div>
            </div>

            <div class="field">
              <div class="control">
                <%= f.button :submit, "Log in", class: "button is-warning is-fullwidth" %>
              </div>
            </div>
          <% end %>
          
          <div class="auth-links has-text-centered mt-4">
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>