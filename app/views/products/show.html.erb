<% content_for :body_class, 'bg-light' %>

<section class="section product-show">
  <div class="container">
    <div class="columns is-vcentered">
      <div class="column is-7">
        <div class="feature-image-container">
          <% if @product.image.attached? %>
            <%= image_tag @product.image, class: "product-image is-rounded shadow" %>
          <% else %>
            <div class="no-image-placeholder">
              <i class="fas fa-image fa-4x has-text-grey-lighter"></i>
              <p>No image available</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="column is-5">
        <div class="product-details p-6 has-background-white shadow rounded">
          <h1 class="title is-2 mb-2"><%= @product.title %></h1>
          
          <div class="price-tag mb-4">
            <span class="title is-3 has-text-primary"><%= number_to_currency(@product.price) %></span>
          </div>

          <div class="tags are-medium mb-4">
            <% if @product.brand? %>
              <span class="tag is-info"><%= @product.brand %></span>
            <% end %>
            <span class="tag is-success"><%= @product.model %></span>
            <% if @product.condition? %>
              <span class="tag is-warning"><%= @product.condition %></span>
            <% end %>
          </div>

          <div class="description mb-5">
            <h3 class="subtitle is-4">Description</h3>
            <div class="content">
              <%= @product.description %>
            </div>
          </div>

          <div class="specifications mb-5">
            <h3 class="subtitle is-4">Specifications</h3>
            <table class="table is-fullwidth">
              <% if @product.condition %>
                <tr>
                  <th>Condition</th>
                  <td><%= @product.condition %></td>
                </tr>
              <% end %>
              <% if @product.finish %>
                <tr>
                  <th>Finish</th>
                  <td><%= @product.finish %></td>
                </tr>
              <% end %>
              <% if @product.brand %>
                <tr>
                  <th>Brand</th>
                  <td><%= @product.brand %></td>
                </tr>
              <% end %>
              <tr>
                <th>Model</th>
                <td><%= @product.model %></td>
              </tr>
            </table>
          </div>

          <div class="seller-info has-text-centered p-4 has-background-light rounded">
            <p class="mb-2">Sold by</p>
            <p class="title is-5"><%= @product.user.name %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>