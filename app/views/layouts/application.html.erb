<!DOCTYPE html>
<html>
  <head>
    <title>Shop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="<%= yield (:body_class) %>">
  <div data-controller="notification">
  <% if flash[:notice] %>
    <div class="notification is-success global-notification" data-notification-target="notice">
      <p class="notice"><%= notice %></p>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="notification is-danger global-notification" data-notification-target="notice">
      <p class="alert"><%= alert %></p>
    </div>
  <% end %>
</div>
     <nav class="navbar is-warning is-spaced" role="navigation" aria-label="main navigation">
      <div class="navbar-brand">
      <div class="navbar-burger burger" data-target="navbar">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

      <div id="navbar" class="navbar-menu">
        <div class="navbar-start">
          <!-- Left side of navbar -->
        </div>
        
        <div class="navbar-item has-text-centered is-expanded">
          <%= link_to root_path, class:"has-text-centered" do %>
            <h1 class="title is-3">Shop</h1>
          <% end %>
        </div>
        
        <div class="navbar-end">
          <div class="navbar-item">
            <div class="field is-grouped">

            <% if user_signed_in? %>
              <%= link_to 'Sell', new_product_path, class: "navbar-item button is-dark" %>

              <div class="navbar-item has-dropdown is-hoverable">
                <%= link_to 'Account', edit_user_registration_path, class: "navbar-link" %>
                <div class="navbar-dropdown is-right">
                  <%= link_to current_user.name, edit_user_registration_path, class:"navbar-item" %>
                  <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "navbar-item button is-text", form: { class: "navbar-item" } %>
                </div>
              </div>
            <% else %>

            <%= link_to "Sign In", new_user_session_path, class:"navbar-item button is-warning" %>
            <%= link_to "Sign up", new_user_registration_path, class:"navbar-item button is-warning"%>

            <% end %>

            </div>
          </div>
          <div class="navbar-item">
            <%= render 'layouts/cart_nav' %>
          </div>
         </div>
    </div>
  </nav>

  <%= yield(:header) %>

  <div class="container">

    <%= yield %>

  </div>

  </body>
</html>
