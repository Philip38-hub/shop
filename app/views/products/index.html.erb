

<section class="section">
  <div class="container">
    <h1 class="title is-2">Browse Products</h1>
    
    <div class="columns is-multiline">
      <% @products.each do |product| %>
        <div class="column is-3">
          <div class="card product-card">
            <div class="card-image">
              <figure>
                <%= link_to product do %>
                  <% if product.image.attached? %>
                    <%= image_tag product.image, class: "product-image", style: "width: 100%; height: 220px; object-fit: cover;" %>
                  <% else %>
                    <div style="height: 220px;" class="has-background-light is-flex is-align-items-center is-justify-content-center">
                      <p class="has-text-centered p-4">No image available</p>
                    </div>
                  <% end %>
                <% end %>
              </figure>
              
              <div class="price-tag">
                <%= number_to_currency(product.price) %>
              </div>
              
              <% if product.condition? %>
                <div class="condition">
                  <span class="tag is-dark"><%= product.condition %></span>
                </div>
              <% end %>
              
              <% if user_signed_in? && current_user.id == product.user_id %>
                <div class="card-actions">
                  <%= link_to edit_product_path(product), class: "button is-small" do %>
                    <span class="icon">
                      <i class="fa fa-edit"></i>
                    </span>
                  <% end %>
                  
                  <%= button_to product_path(product), method: :delete, form: { data: { turbo_confirm: 'Are you sure you want to delete this product?' } }, class: "button is-small is-danger" do %>
                    <span class="icon">
                      <i class="fa fa-trash"></i>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
            
            <div class="card-content">
              <p class="title is-5" style="min-height: 3rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= link_to product.title, product %>
              </p>
              
              <p class="subtitle is-6 has-text-grey" style="margin-top: 0.5rem; margin-bottom: 1rem;">
                Sold by: <%= product_author(product) %>
              </p>
              
              <div class="mt-3">
                <%= render 'add_to_cart', product: product %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
