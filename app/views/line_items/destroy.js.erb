// Update cart count in navbar
document.querySelector('#cart-count').innerHTML = '<%= @cart.total_items %>';

// Remove line item from cart
var lineItem = document.querySelector('#line-item-<%= @line_item.id %>');
if (lineItem) {
  lineItem.remove();
}

// Update cart total
document.querySelector('#cart-total').innerHTML = '<%= number_to_currency(@cart.total_price) %>';

// Show notification using your standard flash style
var notification = document.createElement('div');
notification.className = 'notification is-success global-notification';
notification.innerHTML = '<p class="notice">Removed from your cart</p>';
document.body.insertAdjacentElement('afterbegin', notification);

// Auto-dismiss notification
setTimeout(function() {
  notification.style.opacity = '0';
  notification.style.transition = 'opacity 1s';
  setTimeout(function() {
    notification.remove();
  }, 1000);
}, 3000);

// If cart is empty, refresh the page
<% if @cart.line_items.empty? %>
  window.location.reload();
<% end %>